{
  "name": "security_scanner",
  "version": "0.1.0",
  "type": "module",
  "description": "Scanner de segurança para APIs — audita JWT, cookies, HTTPS e simula ataques comuns",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "scan": "node --env-file=.env index.js",
    "reset-device": "node --env-file=.env utils/reset-device.js",
    "gerar-chaves": "node utils/gerar-par-chaves.js",
    "descriptar": "node utils/descriptar-sessao.js",
    "testar-rota": "node --env-file=.env utils/testar-rota-protegida.js",
    "lint": "eslint ."
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
